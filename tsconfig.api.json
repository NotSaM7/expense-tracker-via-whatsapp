{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": ".vercel/output",
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["api", "lib"]
}
