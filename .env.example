# ─── Supabase ────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
# From Meta Developer Console → WhatsApp → API Setup
WHATSAPP_TOKEN=your-whatsapp-bearer-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=a-random-secret-you-choose-for-webhook-verification
# From Meta Developer Console → App Settings → Basic → App Secret
WHATSAPP_APP_SECRET=your-meta-app-secret

# ─── Your personal WhatsApp number (E.164 format, no + prefix) ───────────────
MY_WHATSAPP_NUMBER=919876543210

# ─── Google Gemini API (Optional Fallback Parser) ─────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
CRON_SECRET=my_super_secret_cron_key_12345
